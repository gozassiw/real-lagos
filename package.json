{
  "name": "real-lagos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Playable 3D browser life-sim prototype built on real OpenStreetMap geography of Lagos, Nigeria.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "osm:fetch": "node scripts/fetch-osm.mjs --out osm-raw",
    "map:build": "python3 scripts/build_map.py --raw osm-raw --out public/data/lagos"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
